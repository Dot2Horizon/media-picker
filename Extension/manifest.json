{
  "manifest_version": 3,
  "name": "MediaPicker Bridge",
  "description": "MediaPicker 맥 앱이 탭의 미디어를 재생·정지할 수 있게 연결합니다.",
  "version": "0.1.0",
  "permissions": ["tabs", "alarms"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["media-actions.js", "content.js"],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
